PORT=8787
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Set this when the proxy is exposed to the public internet.
# Codex/client should send Authorization: Bearer <PROXY_API_KEY>.
PROXY_API_KEY=

# Set true if you want the proxy to ignore the client's model field.
FORCE_MODEL=false

# CORS origin for browser testing. Keep restrictive in production.
ALLOW_ORIGIN=*
REQUEST_TIMEOUT_MS=600000
